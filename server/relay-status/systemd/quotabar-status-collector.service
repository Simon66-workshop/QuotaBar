[Unit]
Description=QuotaBar relay status snapshot collector
After=systemd-tmpfiles-setup.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -IB /opt/quotabar-relay-status/run-collector.py
TimeoutStartSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=-/var/lib/66-relay -/var/lib/66-relay-control /etc/quotabar-relay-status
ReadWritePaths=/run/quotabar-relay-status
InaccessiblePaths=/run/quotabar-relay-status/api
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
# Cannot use PrivateNetwork: inspect host loopback TLS, never an external address.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32

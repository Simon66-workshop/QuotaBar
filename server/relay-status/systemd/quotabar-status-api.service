[Unit]
Description=QuotaBar relay status Unix socket API
After=systemd-tmpfiles-setup.service

[Service]
Type=exec
User=quotabar-status
Group=quotabar-status
LoadCredential=verify.json:/etc/quotabar-relay-status/verify.json
ExecStart=/usr/bin/python3 -IB /opt/quotabar-relay-status/run-api.py
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
MemoryMax=32M
TasksMax=12
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/run/quotabar-relay-status
ReadWritePaths=/run/quotabar-relay-status/api
InaccessiblePaths=-/var/lib/66-relay -/var/lib/66-relay-control /etc/quotabar-relay-status
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
